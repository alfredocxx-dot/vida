DirectoryIndex index.php index.html dist/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Servir assets directamente desde dist si existen
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # Redirigir todas las demás rutas a index.php para el enrutamiento SPA
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php [L]
</IfModule>
